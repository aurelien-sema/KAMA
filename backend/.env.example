# dev ou prod
KAMA_ENV=dev
KAMA_HOST=127.0.0.1
KAMA_PORT=8000

# Obligatoire en prod, ex. chrome-extension://<identifiant de l'extension>
KAMA_ALLOWED_ORIGINS=
# Firefox attribue un identifiant different a chaque installation
KAMA_ALLOW_FIREFOX=false
# A activer uniquement derriere un proxy de confiance
KAMA_TRUST_PROXY=false

KAMA_RATE_PER_MIN=60
KAMA_VOICE_RATE_PER_MIN=12
KAMA_GLOBAL_RATE_PER_MIN=1200
KAMA_MAX_CONCURRENT_MODELS=2

KAMA_NEAR_MATCH_THRESHOLD=0.86
# Laisse a false tant que les modeles n'ont pas ete valides sur les textes bancaires
KAMA_MT_ALLOW_CRITICAL=false

# Dossier des poids, hors du depot
KAMA_MODELS_DIR=../../models
