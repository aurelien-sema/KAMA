{
  "name": "kama-extension",
  "description": "Kama explique la banque en ligne dans ta langue.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:jury": "wxt build --mode jury && wxt build -b edge --mode jury",
    "banque-demo": "node scripts/banque-demo.mjs",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node --test tests/*.test.mjs",
    "phrases": "node scripts/phrases-fenetre.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/krona-one": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  }
}
